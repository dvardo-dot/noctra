{
  "name": "noctra",
  "version": "1.4.0",
  "private": true,
  "description": "NOCTRA: três perfis, vinil e biblioteca de vidro",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node prepare.cjs && electron app",
    "pack": "node prepare.cjs && electron-builder --dir",
    "dist": "node prepare.cjs && electron-builder --win nsis"
  },
  "dependencies": {
    "music-metadata": "^12.3.5"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.noctra.player",
    "productName": "NOCTRA",
    "asar": true,
    "directories": {
      "app": "app",
      "output": "dist"
    },
    "files": [
      "**/*",
      "!NOCTRA-data/**",
      "!.git/**",
      "!node_modules/.cache/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/noctra.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "NOCTRA",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "artifactName": "NOCTRA-1.4.0-Setup.${ext}",
    "extraMetadata": {
      "name": "noctra",
      "productName": "NOCTRA",
      "version": "1.4.0"
    }
  },
  "type": "module",
  "author": "NOCTRA"
}